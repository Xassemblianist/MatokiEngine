;; asm/bilinear_gather.wat — 4-lane (quad) çift doğrusal (bilinear) doku örnekleme çekirdeği.
;; Clang'ı yenme stratejisi:
;; 1) Clang -O2 -msimd128, indeksli doku okumaları (`px[r0 + x0]`) yüzünden döngüyü vektörleştiremez
;;    (WebAssembly SIMD128'de donanım gather komutu yoktur) ve tüm koordinat, floor, kesir ve 16 adet
;;    lerp hesabını tamamen skaler (`f32.floor`, `f32.mul`, `f32.add`, `f32.store`) üretir.
;; 2) Elle WAT'ta:
;;    - 4 lane'in UV koordinat hesabı (`fu, fv, x0f, y0f, ax, ay`) `f32x4` ile paralel yapılır.
;;    - 4 komşu texel'in (`t00, t10, t01, t11`) bellek adresleri `i32x4` vektörleriyle paralel hesaplanır.
;;    - Yalnızca bellekten okuma aşamasında `i32x4.extract_lane` + `v128.load32_zero` +
;;      `v128.load32_lane 1/2/3` ile 4 lane'in texel'leri tek bir `v128` yazmacında toplanır (yazılım gather).
;;    - R, G, B, A kanallarının [0..1] dönüşümü ve çift doğrusal `lerp` hesabı tekrar tamamen
;;      `f32x4` vektörleriyle yapılıp SoA çıkış tamponuna 4 adet `v128.store` ile yazılır.
(module
  (import "env" "memory" (memory 1 16384 shared))
  (func $bilinear_gather (export "bilinear_gather")
    (param $tex i32) (param $u i32) (param $v i32) (param $out_rgba i32) (param $quad_count i32)
    (local $px_base i32)
    (local $log2_w i32)
    (local $stride_bytes i32)
    (local $out_r i32)
    (local $out_g i32)
    (local $out_b i32)
    (local $out_a i32)
    (local $end_u i32)
    (local $vwf v128)
    (local $vhf v128)
    (local $vw_mask v128)
    (local $vh_mask v128)
    (local $vpx_base v128)
    (local $vhalf v128)
    (local $vinv255 v128)
    (local $vmask_ff v128)
    (local $vc1 v128)
    (local $fu v128)
    (local $fv v128)
    (local $x0f v128)
    (local $y0f v128)
    (local $ax v128)
    (local $ay v128)
    (local $x0i v128)
    (local $y0i v128)
    (local $x0 v128)
    (local $x1 v128)
    (local $r0 v128)
    (local $r1 v128)
    (local $addr00 v128)
    (local $addr10 v128)
    (local $addr01 v128)
    (local $addr11 v128)
    (local $p00 v128)
    (local $p10 v128)
    (local $p01 v128)
    (local $p11 v128)
    (local $c00 v128)
    (local $c10 v128)
    (local $c01 v128)
    (local $c11 v128)
    (local $top v128)
    (local $bot v128)

    (if (i32.eqz (local.get $quad_count))
      (then (return))
    )

    ;; Texture başlığından sabitleri oku (shade_abi.h ofsetleri)
    (local.set $px_base (i32.load offset=0  (local.get $tex)))
    (local.set $vwf     (f32x4.splat (f32.convert_i32_s (i32.load offset=4  (local.get $tex)))))
    (local.set $vhf     (f32x4.splat (f32.convert_i32_s (i32.load offset=8  (local.get $tex)))))
    (local.set $vw_mask (i32x4.splat (i32.load offset=12 (local.get $tex))))
    (local.set $vh_mask (i32x4.splat (i32.load offset=16 (local.get $tex))))
    (local.set $log2_w  (i32.load offset=20 (local.get $tex)))
    (local.set $vpx_base (i32x4.splat (local.get $px_base)))

    (local.set $vhalf    (v128.const f32x4 0.5 0.5 0.5 0.5))
    (local.set $vinv255  (f32x4.splat (f32.div (f32.const 1.0) (f32.const 255.0))))
    (local.set $vmask_ff (v128.const i32x4 255 255 255 255))
    (local.set $vc1      (v128.const i32x4 1 1 1 1))

    (local.set $stride_bytes (i32.shl (local.get $quad_count) (i32.const 4)))
    (local.set $out_r (local.get $out_rgba))
    (local.set $out_g (i32.add (local.get $out_r) (local.get $stride_bytes)))
    (local.set $out_b (i32.add (local.get $out_g) (local.get $stride_bytes)))
    (local.set $out_a (i32.add (local.get $out_b) (local.get $stride_bytes)))
    (local.set $end_u (i32.add (local.get $u) (local.get $stride_bytes)))

    (loop $quad_loop
      ;; fu = u * wf - 0.5, fv = v * hf - 0.5
      (local.set $fu (f32x4.sub (f32x4.mul (v128.load (local.get $u)) (local.get $vwf)) (local.get $vhalf)))
      (local.set $fv (f32x4.sub (f32x4.mul (v128.load (local.get $v)) (local.get $vhf)) (local.get $vhalf)))
      (local.set $x0f (f32x4.floor (local.get $fu)))
      (local.set $y0f (f32x4.floor (local.get $fv)))
      (local.set $ax  (f32x4.sub (local.get $fu) (local.get $x0f)))
      (local.set $ay  (f32x4.sub (local.get $fv) (local.get $y0f)))

      ;; İndeks ve satır ofsetleri (4 lane paralel i32x4)
      (local.set $x0i (i32x4.trunc_sat_f32x4_s (local.get $x0f)))
      (local.set $y0i (i32x4.trunc_sat_f32x4_s (local.get $y0f)))
      (local.set $x0  (v128.and (local.get $x0i) (local.get $vw_mask)))
      (local.set $x1  (v128.and (i32x4.add (local.get $x0i) (local.get $vc1)) (local.get $vw_mask)))
      (local.set $r0  (i32x4.shl (v128.and (local.get $y0i) (local.get $vh_mask)) (local.get $log2_w)))
      (local.set $r1  (i32x4.shl (v128.and (i32x4.add (local.get $y0i) (local.get $vc1)) (local.get $vh_mask)) (local.get $log2_w)))

      ;; 4 komşu texel adres vektörü: px_base + ((r + x) << 2)
      (local.set $addr00 (i32x4.add (local.get $vpx_base) (i32x4.shl (i32x4.add (local.get $r0) (local.get $x0)) (i32.const 2))))
      (local.set $addr10 (i32x4.add (local.get $vpx_base) (i32x4.shl (i32x4.add (local.get $r0) (local.get $x1)) (i32.const 2))))
      (local.set $addr01 (i32x4.add (local.get $vpx_base) (i32x4.shl (i32x4.add (local.get $r1) (local.get $x0)) (i32.const 2))))
      (local.set $addr11 (i32x4.add (local.get $vpx_base) (i32x4.shl (i32x4.add (local.get $r1) (local.get $x1)) (i32.const 2))))

      ;; Yazılım gather: load32_zero + load32_lane 1/2/3
      (local.set $p00 (v128.load32_zero (i32x4.extract_lane 0 (local.get $addr00))))
      (local.set $p00 (v128.load32_lane 1 (i32x4.extract_lane 1 (local.get $addr00)) (local.get $p00)))
      (local.set $p00 (v128.load32_lane 2 (i32x4.extract_lane 2 (local.get $addr00)) (local.get $p00)))
      (local.set $p00 (v128.load32_lane 3 (i32x4.extract_lane 3 (local.get $addr00)) (local.get $p00)))

      (local.set $p10 (v128.load32_zero (i32x4.extract_lane 0 (local.get $addr10))))
      (local.set $p10 (v128.load32_lane 1 (i32x4.extract_lane 1 (local.get $addr10)) (local.get $p10)))
      (local.set $p10 (v128.load32_lane 2 (i32x4.extract_lane 2 (local.get $addr10)) (local.get $p10)))
      (local.set $p10 (v128.load32_lane 3 (i32x4.extract_lane 3 (local.get $addr10)) (local.get $p10)))

      (local.set $p01 (v128.load32_zero (i32x4.extract_lane 0 (local.get $addr01))))
      (local.set $p01 (v128.load32_lane 1 (i32x4.extract_lane 1 (local.get $addr01)) (local.get $p01)))
      (local.set $p01 (v128.load32_lane 2 (i32x4.extract_lane 2 (local.get $addr01)) (local.get $p01)))
      (local.set $p01 (v128.load32_lane 3 (i32x4.extract_lane 3 (local.get $addr01)) (local.get $p01)))

      (local.set $p11 (v128.load32_zero (i32x4.extract_lane 0 (local.get $addr11))))
      (local.set $p11 (v128.load32_lane 1 (i32x4.extract_lane 1 (local.get $addr11)) (local.get $p11)))
      (local.set $p11 (v128.load32_lane 2 (i32x4.extract_lane 2 (local.get $addr11)) (local.get $p11)))
      (local.set $p11 (v128.load32_lane 3 (i32x4.extract_lane 3 (local.get $addr11)) (local.get $p11)))

      ;; Kanal R (bit 0..7)
      (local.set $c00 (f32x4.mul (f32x4.convert_i32x4_u (v128.and (local.get $p00) (local.get $vmask_ff))) (local.get $vinv255)))
      (local.set $c10 (f32x4.mul (f32x4.convert_i32x4_u (v128.and (local.get $p10) (local.get $vmask_ff))) (local.get $vinv255)))
      (local.set $c01 (f32x4.mul (f32x4.convert_i32x4_u (v128.and (local.get $p01) (local.get $vmask_ff))) (local.get $vinv255)))
      (local.set $c11 (f32x4.mul (f32x4.convert_i32x4_u (v128.and (local.get $p11) (local.get $vmask_ff))) (local.get $vinv255)))
      (local.set $top (f32x4.add (local.get $c00) (f32x4.mul (f32x4.sub (local.get $c10) (local.get $c00)) (local.get $ax))))
      (local.set $bot (f32x4.add (local.get $c01) (f32x4.mul (f32x4.sub (local.get $c11) (local.get $c01)) (local.get $ax))))
      (v128.store (local.get $out_r)
        (f32x4.add (local.get $top) (f32x4.mul (f32x4.sub (local.get $bot) (local.get $top)) (local.get $ay))))

      ;; Kanal G (bit 8..15)
      (local.set $c00 (f32x4.mul (f32x4.convert_i32x4_u (v128.and (i32x4.shr_u (local.get $p00) (i32.const 8)) (local.get $vmask_ff))) (local.get $vinv255)))
      (local.set $c10 (f32x4.mul (f32x4.convert_i32x4_u (v128.and (i32x4.shr_u (local.get $p10) (i32.const 8)) (local.get $vmask_ff))) (local.get $vinv255)))
      (local.set $c01 (f32x4.mul (f32x4.convert_i32x4_u (v128.and (i32x4.shr_u (local.get $p01) (i32.const 8)) (local.get $vmask_ff))) (local.get $vinv255)))
      (local.set $c11 (f32x4.mul (f32x4.convert_i32x4_u (v128.and (i32x4.shr_u (local.get $p11) (i32.const 8)) (local.get $vmask_ff))) (local.get $vinv255)))
      (local.set $top (f32x4.add (local.get $c00) (f32x4.mul (f32x4.sub (local.get $c10) (local.get $c00)) (local.get $ax))))
      (local.set $bot (f32x4.add (local.get $c01) (f32x4.mul (f32x4.sub (local.get $c11) (local.get $c01)) (local.get $ax))))
      (v128.store (local.get $out_g)
        (f32x4.add (local.get $top) (f32x4.mul (f32x4.sub (local.get $bot) (local.get $top)) (local.get $ay))))

      ;; Kanal B (bit 16..23)
      (local.set $c00 (f32x4.mul (f32x4.convert_i32x4_u (v128.and (i32x4.shr_u (local.get $p00) (i32.const 16)) (local.get $vmask_ff))) (local.get $vinv255)))
      (local.set $c10 (f32x4.mul (f32x4.convert_i32x4_u (v128.and (i32x4.shr_u (local.get $p10) (i32.const 16)) (local.get $vmask_ff))) (local.get $vinv255)))
      (local.set $c01 (f32x4.mul (f32x4.convert_i32x4_u (v128.and (i32x4.shr_u (local.get $p01) (i32.const 16)) (local.get $vmask_ff))) (local.get $vinv255)))
      (local.set $c11 (f32x4.mul (f32x4.convert_i32x4_u (v128.and (i32x4.shr_u (local.get $p11) (i32.const 16)) (local.get $vmask_ff))) (local.get $vinv255)))
      (local.set $top (f32x4.add (local.get $c00) (f32x4.mul (f32x4.sub (local.get $c10) (local.get $c00)) (local.get $ax))))
      (local.set $bot (f32x4.add (local.get $c01) (f32x4.mul (f32x4.sub (local.get $c11) (local.get $c01)) (local.get $ax))))
      (v128.store (local.get $out_b)
        (f32x4.add (local.get $top) (f32x4.mul (f32x4.sub (local.get $bot) (local.get $top)) (local.get $ay))))

      ;; Kanal A (bit 24..31)
      (local.set $c00 (f32x4.mul (f32x4.convert_i32x4_u (i32x4.shr_u (local.get $p00) (i32.const 24))) (local.get $vinv255)))
      (local.set $c10 (f32x4.mul (f32x4.convert_i32x4_u (i32x4.shr_u (local.get $p10) (i32.const 24))) (local.get $vinv255)))
      (local.set $c01 (f32x4.mul (f32x4.convert_i32x4_u (i32x4.shr_u (local.get $p01) (i32.const 24))) (local.get $vinv255)))
      (local.set $c11 (f32x4.mul (f32x4.convert_i32x4_u (i32x4.shr_u (local.get $p11) (i32.const 24))) (local.get $vinv255)))
      (local.set $top (f32x4.add (local.get $c00) (f32x4.mul (f32x4.sub (local.get $c10) (local.get $c00)) (local.get $ax))))
      (local.set $bot (f32x4.add (local.get $c01) (f32x4.mul (f32x4.sub (local.get $c11) (local.get $c01)) (local.get $ax))))
      (v128.store (local.get $out_a)
        (f32x4.add (local.get $top) (f32x4.mul (f32x4.sub (local.get $bot) (local.get $top)) (local.get $ay))))

      (local.set $u     (i32.add (local.get $u)     (i32.const 16)))
      (local.set $v     (i32.add (local.get $v)     (i32.const 16)))
      (local.set $out_r (i32.add (local.get $out_r) (i32.const 16)))
      (local.set $out_g (i32.add (local.get $out_g) (i32.const 16)))
      (local.set $out_b (i32.add (local.get $out_b) (i32.const 16)))
      (local.set $out_a (i32.add (local.get $out_a) (i32.const 16)))
      (br_if $quad_loop (i32.lt_u (local.get $u) (local.get $end_u)))
    )
  )
)
