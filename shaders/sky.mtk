// sky.mtk — Analitik atmosferik gök kubbesi: Rayleigh zenit-ufuk gradyanı, Mie güneş halesi,
// keskin güneş diski, yüksek irtifa ince sirüs bulutları ve ACES ton eşleme + gama 2.
uniform sun_dir:     vec3;   // güneşe doğru birim vektör
uniform sun_col:     vec3;   // doğrusal güneş ışınımı
uniform sky_zenith:  vec3;   // zenit gök rengi (doğrusal)
uniform sky_horizon: vec3;   // ufuk gök rengi (doğrusal)
uniform params:      vec4;   // x=bulut zamanı, y=bulut yoğunluğu, z=güneş parlaklığı, w=ufuk sıcaklığı
in nrm: vec3;

fn frag() -> rgba {
    let d = normalize(nrm);
    let y = clamp(d.y, 0.0, 1.0);

    // Ufuk -> zenit Rayleigh gradyanı (ufuk bandında yoğunlaşan dördüncü kuvvet geçişi)
    let iy = 1.0 - clamp(y * 1.85, 0.0, 1.0);
    let iy2 = iy * iy;
    let hz = iy2 * iy;
    let base_sky = mix(sky_zenith, sky_horizon, hz);

    // Güneş yönüyle açısal yakınlık (Mie ileri saçılması + güneş diski)
    let mu = max(dot(d, sun_dir), 0.0);
    let mu2 = mu * mu;
    let mu4 = mu2 * mu2;
    let mu8 = mu4 * mu4;
    let mu16 = mu8 * mu8;
    let mu64 = mu16 * mu16;

    let warm_col = vec3(1.0, 0.48, 0.18) * params.w;
    let mie_glow = (warm_col * (mu4 * hz * 0.55) + sun_col * (mu16 * 0.18 + mu64 * 0.95)) * params.z;
    let sun_disk = sun_col * (smoothstep(0.9978, 0.9994, mu) * (14.0 * params.z));

    // Yüksek irtifa sirüs bulutları (cebirsel kesirli dalga, sin/cos yok)
    let py = max(d.y, 0.08);
    let inv_py = 1.8 / py;
    let uv_c = d.xz * inv_py + vec2(params.x * 0.015, params.x * 0.008);
    let p1 = abs(fract(uv_c * 0.35 + vec2(0.17, 0.43)) * 2.0 - vec2(1.0, 1.0));
    let rot_uv = vec2(uv_c.x * 0.62 - uv_c.y * 0.48, uv_c.x * 0.48 + uv_c.y * 0.62);
    let p2 = abs(fract(rot_uv + vec2(p1.y * 0.35, p1.x * 0.35)) * 2.0 - vec2(1.0, 1.0));
    let n_val = (p1.x * p1.y + p2.x * 0.6 + p2.y * 0.4) * 0.5;
    let c_vis = smoothstep(0.42, 0.80, n_val) * smoothstep(0.04, 0.26, y);
    let cloud_mask = c_vis * (1.0 - y * 0.55) * params.y;
    let cloud_lit = mix(sky_horizon * 1.10, sun_col * 0.55 + vec3(0.95, 0.92, 0.88), 0.35 + 0.65 * mu4);

    let below = smoothstep(-0.06, 0.0, d.y);
    let under_col = sky_horizon * 0.55;
    let sky_above = mix(base_sky + mie_glow, cloud_lit, cloud_mask) + sun_disk;
    let c = mix(under_col, sky_above, below);

    // ACES (Narkowicz) + gama 2
    let tm = (c * (c * 2.51 + vec3(0.03, 0.03, 0.03))) / (c * (c * 2.43 + vec3(0.59, 0.59, 0.59)) + vec3(0.14, 0.14, 0.14));
    let o = sqrt(clamp(tm, vec3(0.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0)));
    return vec4(o.r, o.g, o.b, 1.0);
}
