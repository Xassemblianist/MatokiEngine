/* atmos_skyview.mtk — Hillaire 2020 Sky-View LUT (192x108) compute çekirdeği.
 * Ufuk etrafında doğrusal olmayan enlem + azimut parametrizasyonuyla her karede
 * tekli Rayleigh/Mie saçılması + çoklu saçılma (ms_lut) integralini hesaplar.
 */

uniform u_sky_params: vec4; /* x = w (192), y = h (108), z = cam_h_km, w = mie_g (0.80) */
uniform u_sun_dir:    vec4; /* xyz = güneş yönü (birim), w = güneş şiddeti */
uniform u_lut_dims:   vec4; /* x = trans_w (256), y = trans_h (64), z = ms_w (32), w = ms_h (32) */

buffer trans_lut: buffer<vec4>;
buffer ms_lut:    buffer<vec4>;
buffer out_sky:   buffer<vec4>;

const PI:       f32 = 3.14159265;
const HALF_PI:  f32 = 1.57079633;
const R_BOTTOM: f32 = 6360.0;
const R_TOP:    f32 = 6460.0;

fn fast_exp_neg(x: f32) -> f32 {
    let u: f32 = max(x, 0.0) * 0.5;
    let d: f32 = 1.0 + u * (1.0 + u * 0.5);
    return 1.0 / (d * d);
}

fn ray_dist(r: f32, mu: f32) -> f32 {
    let db: f32    = r * r * (mu * mu - 1.0) + R_BOTTOM * R_BOTTOM;
    let d_bot: f32 = max(0.0, -r * mu - sqrt(max(0.0, db)));
    let dt: f32    = max(0.0, r * r * (mu * mu - 1.0) + R_TOP * R_TOP);
    let d_top: f32 = max(0.0, -r * mu + sqrt(dt));
    let hit_g: f32 = step(0.0, -mu) * step(0.0, db);
    return mix(d_top, d_bot, hit_g);
}

fn phase_rayleigh(cos_t: f32) -> f32 {
    return 0.05968310 * (1.0 + cos_t * cos_t);
}

fn phase_mie(cos_t: f32, g: f32) -> f32 {
    let g2: f32   = g * g;
    let num: f32  = 3.0 * (1.0 - g2) * (1.0 + cos_t * cos_t);
    let base: f32 = max(1.0 + g2 - 2.0 * g * cos_t, 0.0001);
    return num / (25.1327412 * (2.0 + g2) * base * sqrt(base));
}

fn compute() {
    let gid: u32 = global_id;
    let sp: vec4 = u_sky_params;
    let sd: vec4 = u_sun_dir;
    let ld: vec4 = u_lut_dims;
    let w: u32   = u32(sp.x);
    let h: u32   = u32(sp.y);
    if gid >= w * h {
        return;
    }

    let y: u32 = u32(floor((f32(gid) + 0.5) / sp.x));
    let x: u32 = gid - y * w;

    let u: f32 = (f32(x) + 0.5) / sp.x;
    let v: f32 = (f32(y) + 0.5) / sp.y;

    let azim: f32 = (u - 0.5) * 2.0 * PI;
    let sn: f32   = step(0.5, v) * 2.0 - 1.0;
    let dv: f32   = (v - 0.5) * 2.0;
    let elev: f32 = sn * dv * dv * HALF_PI;

    let ce: f32       = cos(elev);
    let ray_dir: vec3 = vec3(ce * cos(azim), sin(elev), ce * sin(azim));
    let sun_dir: vec3 = normalize(sd.xyz);

    let r: f32     = clamp(R_BOTTOM + sp.z, R_BOTTOM + 0.002, R_TOP - 0.01);
    let s_max: f32 = min(ray_dist(r, ray_dir.y), 350.0);
    let ds: f32    = s_max * 0.1;

    let cos_t: f32 = dot(ray_dir, sun_dir);
    let pr: f32    = phase_rayleigh(cos_t);
    let pm: f32    = phase_mie(cos_t, sp.w);

    let tw: f32   = ld.x;
    let th: f32   = ld.y;
    let mw: f32   = ld.z;
    let mh: f32   = ld.w;
    let tw_u: u32 = u32(tw);
    let mw_u: u32 = u32(mw);

    let beta_r: vec3  = vec3(0.005802, 0.013558, 0.033100);
    let beta_ms: vec3 = vec3(0.003996, 0.003996, 0.003996);
    let beta_me: vec3 = vec3(0.004440, 0.004440, 0.004440);
    let beta_o: vec3  = vec3(0.000650, 0.001881, 0.000085);
    let one3: vec3    = vec3(1.0, 1.0, 1.0);
    let r_bot2: f32   = R_BOTTOM * R_BOTTOM;

    var trans: vec3 = one3;
    var lum:   vec3 = vec3(0.0, 0.0, 0.0);

    for i in 0..10 {
        let s: f32     = (f32(i) + 0.5) * ds;
        let pos: vec3  = vec3(ray_dir.x * s, r + ray_dir.y * s, ray_dir.z * s);
        let r_s: f32   = length(pos);
        let h_s: f32   = max(0.0, r_s - R_BOTTOM);
        let mu_s: f32  = dot(pos, sun_dir) / max(r_s, 1.0);

        let d_r: f32 = fast_exp_neg(h_s * 0.125);
        let d_m: f32 = fast_exp_neg(h_s * 0.83333333);
        let d_o: f32 = max(0.0, 1.0 - abs(h_s - 25.0) * 0.06666667);

        let sr: vec3  = beta_r * d_r;
        let sm: vec3  = beta_ms * d_m;
        let ext: vec3 = sr + beta_me * d_m + beta_o * d_o;

        let tau_s: vec3  = ext * ds;
        let step_t: vec3 = one3 / (one3 + tau_s * (one3 + tau_s * 0.5));
        let sint: vec3   = (one3 + tau_s * 0.5) * step_t * ds;

        let mu_hor: f32  = -sqrt(max(0.0, 1.0 - r_bot2 / (r_s * r_s)));
        let sun_vis: f32 = step(mu_hor, mu_s);
        let vh: f32      = sqrt(clamp(h_s * 0.01, 0.0, 1.0));
        let ut: f32      = clamp((mu_s + 0.25) * 0.8, 0.0, 1.0);
        let ixt: u32     = u32(clamp(floor(ut * tw), 0.0, tw - 1.0));
        let iyt: u32     = u32(clamp(floor(vh * th), 0.0, th - 1.0));
        let t_sun: vec3  = trans_lut[iyt * tw_u + ixt].xyz * sun_vis;

        let um: f32      = clamp((mu_s + 0.2) * 0.83333333, 0.0, 1.0);
        let ixm: u32     = u32(clamp(floor(um * mw), 0.0, mw - 1.0));
        let iym: u32     = u32(clamp(floor(vh * mh), 0.0, mh - 1.0));
        let psi_ms: vec3 = ms_lut[iym * mw_u + ixm].xyz;

        let single_s: vec3 = (sr * pr + sm * pm) * t_sun;
        let multi_s: vec3  = (sr + sm) * psi_ms;

        lum   += trans * (single_s + multi_s) * sint;
        trans  = trans * step_t;
    }

    out_sky[gid] = vec4(lum * sd.w, 1.0);
}
