// GPU Akışkan (PBF) — Aşama 1: Uzamsal hash ızgarası hücre sayaçlarını sıfırlama
// 64x64x64 = 262.144 hücrenin tamamını her adımda 0u ile temizler.

uniform cell_count: u32;

buffer cell_counts: buffer<u32>;

fn compute() {
    let i: u32 = global_id;
    if (i < cell_count) {
        cell_counts[i] = 0u;
    }
}
