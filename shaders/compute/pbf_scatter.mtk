// GPU Akışkan (PBF) — Aşama 4: Counting-sort parçacık yeniden sıralama (scatter)
// Parçacıkları cell_offsets[cell] + rank adresine sıralayarak komşu aramada
// GPU önbellek yerelliğini (cache locality) en üst düzeye çıkarır.

uniform particle_count: u32;
uniform grid_params: vec4;
uniform box_min: vec4;
uniform box_max: vec4;
uniform kernel_params: vec4;
uniform solver_params: vec4;
uniform vort_params: vec4;
uniform sphere0: vec4;
uniform sphere0_vel: vec4;
uniform sphere1: vec4;
uniform box_obs: vec4;

buffer positions: buffer<vec4>;
buffer pred_pos: buffer<vec4>;
buffer cell_offsets: buffer<u32>;
buffer particle_cell: buffer<u32>;
buffer particle_rank: buffer<u32>;
buffer sorted_pos: buffer<vec4>;
buffer sorted_orig_pos: buffer<vec4>;

fn compute() {
    let idx: u32 = global_id;
    if (idx < particle_count) {
        let cell: u32 = particle_cell[idx];
        let rank: u32 = particle_rank[idx];
        let dst: u32 = cell_offsets[cell] + rank;
        if (dst < particle_count) {
            sorted_pos[dst] = pred_pos[idx];
            sorted_orig_pos[dst] = positions[idx];
        }
    }
}
