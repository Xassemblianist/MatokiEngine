// GPU Akışkan (PBF) — Aşama 3a: Blok içi (64 eleman) dışlayıcı önek toplamı (exclusive prefix scan)
// Her iş parçacığı 64 ardışık hücrenin dışlayıcı önek toplamını hesaplar ve blok toplamını yazar.
// 3 seviyeli hiyerarşi: 262.144 -> 4096 -> 64 -> 1.

uniform block_count: u32;

buffer in_counts: buffer<u32>;
buffer out_offsets: buffer<u32>;
buffer out_sums: buffer<u32>;

fn compute() {
    let b: u32 = global_id;
    if (b < block_count) {
        let base: u32 = b << 6u;
        var acc: u32 = 0u;
        for k in 0..64 {
            let idx: u32 = base + u32(k);
            let c: u32 = in_counts[idx];
            out_offsets[idx] = acc;
            acc = acc + c;
        }
        out_sums[b] = acc;
    }
}
