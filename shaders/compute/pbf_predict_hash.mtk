// GPU Akışkan (PBF — Macklin 2013) — Aşama 2: Dış kuvvetler, konum tahmini ve uzamsal hash
// Parçacık hızına yerçekimi uygular, tahmini konumu (p*_i) hesaplar, 64x64x64 ızgara
// hücresini belirler ve atomic_add ile hücre içi sıra numarasını (rank) alır.

uniform particle_count: u32;
uniform grid_params: vec4;
uniform box_min: vec4;
uniform box_max: vec4;
uniform kernel_params: vec4;
uniform solver_params: vec4;
uniform vort_params: vec4;
uniform sphere0: vec4;
uniform sphere0_vel: vec4;
uniform sphere1: vec4;
uniform box_obs: vec4;

buffer positions: buffer<vec4>;
buffer velocities: buffer<vec4>;
buffer pred_pos: buffer<vec4>;
buffer cell_counts: buffer<u32>;
buffer particle_cell: buffer<u32>;
buffer particle_rank: buffer<u32>;

fn compute() {
    let idx: u32 = global_id;
    if (idx < particle_count) {
        let pos_f: vec4 = positions[idx];
        let vel_f: vec4 = velocities[idx];
        let dt: f32 = box_min.w;
        let grav_y: f32 = box_max.w;

        let vx: f32 = vel_f.x;
        let vy: f32 = vel_f.y + grav_y * dt;
        let vz: f32 = vel_f.z;

        let px: f32 = clamp(pos_f.x + vx * dt, box_min.x, box_max.x);
        let py: f32 = clamp(pos_f.y + vy * dt, box_min.y, box_max.y);
        let pz: f32 = clamp(pos_f.z + vz * dt, box_min.z, box_max.z);

        pred_pos[idx] = vec4(px, py, pz, pos_f.w);

        let inv_cs: f32 = grid_params.w;
        let gx: i32 = clamp(i32((px - grid_params.x) * inv_cs), 0, 63);
        let gy: i32 = clamp(i32((py - grid_params.y) * inv_cs), 0, 63);
        let gz: i32 = clamp(i32((pz - grid_params.z) * inv_cs), 0, 63);

        let cell: u32 = u32(gx) + (u32(gz) << 6u) + (u32(gy) << 12u);
        let rank: u32 = atomic_add(cell_counts, cell, 1u);

        particle_cell[idx] = cell;
        particle_rank[idx] = rank;
    }
}
